# ================================================================
# VERBAMIND — Environment Variables
# Copy this file to .env and fill in real values before running.
# Never commit .env to git.
# ================================================================

# ---- Database (Postgres + pgvector) ----
POSTGRES_DB=verbamind
POSTGRES_USER=verbamind
POSTGRES_PASSWORD=change-me-strong-password
DB_URL=jdbc:postgresql://localhost:5432/verbamind
DB_USERNAME=verbamind
DB_PASSWORD=change-me-strong-password

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- JWT ----
# Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-very-long-random-secret-at-least-48-chars

# ---- MinIO (document storage) ----
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=verbamind-prod

# ---- Email (Gmail SMTP) ----
# Use a Gmail App Password — NOT your real Gmail password.
# Enable 2FA on Gmail, then: Google Account → Security → App Passwords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-app-email@gmail.com
MAIL_PASSWORD=your-16-char-app-password

# ---- App URLs ----
# Backend public URL (your Render backend URL)
APP_BASE_URL=https://verbamind-api.onrender.com
# Frontend public URL (your Vercel frontend URL)
CORS_ALLOWED_ORIGINS=https://verbamind.vercel.app

# ---- AI Provider ----
# Choose one: openai | gemini | ollama
AI_PROVIDER=openai
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=

# ---- Razorpay (Payments) ----
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...
