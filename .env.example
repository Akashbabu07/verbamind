# ---- Database (Postgres, used directly by the app and by docker-compose.prod.yml) ----
POSTGRES_DB=verbamind
POSTGRES_USER=verbamind
POSTGRES_PASSWORD=change-me
DB_URL=jdbc:postgresql://localhost:5432/verbamind
DB_USERNAME=verbamind
DB_PASSWORD=change-me

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- JWT ----
# Generate a long random secret, e.g. `openssl rand -base64 48`
JWT_SECRET=change-me-to-a-long-random-secret

# ---- MinIO (S3-compatible object storage) ----
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=verbamind-prod

# ---- Mail (SMTP, used for verification/reset/invite emails) ----
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ---- App URLs ----
APP_BASE_URL=https://your-domain.example.com
CORS_ALLOWED_ORIGINS=https://your-frontend.example.com

# ---- AI provider ----
# One of: ollama | openai | gemini
# (Anthropic Claude is listed in the roadmap but has no provider implementation yet — see README)
AI_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=

# ---- Razorpay (payments) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
